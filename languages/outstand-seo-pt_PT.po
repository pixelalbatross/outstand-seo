msgid "Meta Description"
msgstr "Meta descrição"

#: src/js/editor/panels/GeneralPanel.js:65
msgid "Overrides the summary shown beneath the title in search results."
msgstr "Substitui o resumo mostrado por baixo do título nos resultados de pesquisa."

#: src/js/editor/panels/SocialPanel.js:16
msgid "Default (from settings)"
msgstr "Por omissão (das opções)"

#: src/js/editor/panels/SocialPanel.js:17
msgid "Summary"
msgstr "Resumo"

#: src/js/editor/panels/SocialPanel.js:19
msgid "Summary with large image"
msgstr "Resumo com imagem grande"

#: src/js/editor/panels/SocialPanel.js:78
msgid "Remove image"
msgstr "Remover imagem"

#: src/js/editor/panels/SocialPanel.js:98
msgid "Social Image"
msgstr "Imagem para redes sociais"

#: src/js/editor/panels/SocialPanel.js:99
msgid "Use a 1.91:1 image at least 1200px wide for reliable results across networks."
msgstr "Use uma imagem com proporção 1,91:1 e pelo menos 1200px de largura para bons resultados em todas as redes."

#: src/js/editor/panels/SocialPanel.js:109
msgid "Open Graph Title"
msgstr "Título Open Graph"

#: src/js/editor/panels/SocialPanel.js:113
msgid "Title shown when this page is shared on Facebook, LinkedIn, and other networks."
msgstr "Título mostrado quando esta página é partilhada no Facebook, LinkedIn e outras redes."

#: src/js/editor/panels/SocialPanel.js:130
msgid "Open Graph Description"
msgstr "Descrição Open Graph"

#: src/js/editor/panels/SocialPanel.js:134
msgid "Description shown when this page is shared on Facebook, LinkedIn, and other networks."
msgstr "Descrição mostrada quando esta página é partilhada no Facebook, LinkedIn e outras redes."

#: src/js/editor/panels/SocialPanel.js:150
msgid "Twitter Title"
msgstr "Título para o Twitter"

#: src/js/editor/panels/SocialPanel.js:154
msgid "Title shown when this page is shared on X (Twitter). Falls back to the Open Graph title."
msgstr "Título mostrado quando esta página é partilhada no X (Twitter). Se estiver vazio, usa o título Open Graph."

#: src/js/editor/panels/SocialPanel.js:171
msgid "Twitter Description"
msgstr "Descrição para o Twitter"

#: src/js/editor/panels/SocialPanel.js:175
msgid "Description shown when this page is shared on X (Twitter). Falls back to the Open Graph description."
msgstr "Descrição mostrada quando esta página é partilhada no X (Twitter). Se estiver vazia, usa a descrição Open Graph."

#: src/js/editor/panels/SocialPanel.js:189
msgid "Twitter Image"
msgstr "Imagem para o Twitter"

#: src/js/editor/panels/SocialPanel.js:195
msgid "Twitter Card Type"
msgstr "Tipo de cartão do Twitter"

#: src/js/editor/panels/SocialPanel.js:199
msgid "Sets how the preview looks on X and platforms like Discord: a small thumbnail or a large cover image."
msgstr "Define o aspecto da pré-visualização no X e em plataformas como o Discord: uma miniatura pequena ou uma imagem de capa grande."

#: src/js/editor/panels/VisibilityPanel.js:25
msgid "Indexing"
msgstr "Indexação"

#: src/js/editor/panels/VisibilityPanel.js:26
msgid "Index"
msgstr "Indexar"

#: src/js/editor/panels/VisibilityPanel.js:27
msgid "No-index"
msgstr "Não indexar"

#: src/js/editor/panels/VisibilityPanel.js:28
msgid "Whether search engines may list this page in their results."
msgstr "Se os motores de pesquisa podem mostrar esta página nos resultados."

#: src/js/editor/panels/VisibilityPanel.js:35
msgid "Link following"
msgstr "Seguimento de ligações"

#: src/js/editor/panels/VisibilityPanel.js:36
msgid "Follow"
msgstr "Seguir"

#: src/js/editor/panels/VisibilityPanel.js:37
msgid "No-follow"
msgstr "Não seguir"

#: src/js/editor/panels/VisibilityPanel.js:38
msgid "Whether search engines may follow the links on this page."
msgstr "Se os motores de pesquisa podem seguir as ligações desta página."

#: src/js/editor/panels/VisibilityPanel.js:45
msgid "Archiving"
msgstr "Arquivamento"

#: src/js/editor/panels/VisibilityPanel.js:46
msgid "Archive"
msgstr "Arquivar"

#: src/js/editor/panels/VisibilityPanel.js:47
msgid "No-archive"
msgstr "Não arquivar"

#: src/js/editor/panels/VisibilityPanel.js:48
msgid "Whether search engines may keep a cached copy of this page."
msgstr "Se os motores de pesquisa podem guardar uma cópia em cache desta página."

#: src/js/editor/panels/VisibilityPanel.js:78
msgid "Default"
msgstr "Por omissão"

#: src/js/editor/panels/VisibilityPanel.js:128
msgid "Canonical URL"
msgstr "URL canónico"

#: src/js/editor/panels/VisibilityPanel.js:132
msgid "Point search engines to this URL as the preferred version of the page."
msgstr "Indica aos motores de pesquisa este URL como a versão preferida da página."

#: src/js/editor/panels/VisibilityPanel.js:143
msgid "Robots Meta Settings"
msgstr "Opções de meta robots"

#: src/js/editor/panels/VisibilityPanel.js:146
msgid "Tell search engines whether to index this page, follow its links, or keep a cached copy."
msgstr "Indica aos motores de pesquisa se podem indexar esta página, seguir as ligações ou guardar uma cópia em cache."

#: src/js/editor/panels/VisibilityPanel.js:156
msgid "No image index"
msgstr "Não indexar imagens"

#: src/js/editor/panels/VisibilityPanel.js:157
msgid "Stop search engines from indexing images on this page."
msgstr "Impede os motores de pesquisa de indexar as imagens desta página."

#: src/js/editor/panels/VisibilityPanel.js:164
msgid "No snippet"
msgstr "Sem fragmento"

#: src/js/editor/panels/VisibilityPanel.js:165
msgid "Stop search engines from showing a text snippet or preview for this page."
msgstr "Impede os motores de pesquisa de mostrar um fragmento de texto ou uma pré-visualização desta página."

#: src/js/editor/panels/VisibilityPanel.js:174
msgid "Archive Settings"
msgstr "Opções de arquivo"

#: src/js/editor/panels/VisibilityPanel.js:178
msgid "Hide this page from this site's search results."
msgstr "Esconder esta página dos resultados de pesquisa deste site."

#: src/js/editor/panels/VisibilityPanel.js:185
msgid "Hide this page from this site's archive listings."
msgstr "Esconder esta página das listagens de arquivo deste site."

#: src/js/editor/panels/VisibilityPanel.js:193
msgid "Cornerstone content"
msgstr "Conteúdo fundamental"

#: src/js/editor/panels/VisibilityPanel.js:194
msgid "Mark this as one of your most important, in-depth pages on its topic — a pillar you want to rank highest and link related posts to."
msgstr "Marque esta como uma das páginas mais importantes e completas sobre o tema: um pilar que quer melhor posicionado e para o qual liga os artigos relacionados."

#: src/js/editor/panels/VisibilityPanel.js:202
msgid "301 Redirect URL"
msgstr "URL de redireccionamento 301"

#: src/js/editor/panels/VisibilityPanel.js:206
msgid "Send visitors and search engines to a different URL."
msgstr "Envia os visitantes e os motores de pesquisa para outro URL."

